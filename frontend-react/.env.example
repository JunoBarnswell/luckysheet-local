# Browser OIDC public-client configuration. Never place a client secret here.
VITE_OIDC_ISSUER=https://identity.example.com
VITE_OIDC_CLIENT_ID=react-sheets-web
VITE_OIDC_AUDIENCE=react-sheets-api
VITE_OIDC_SCOPE=openid profile email
# Optional; defaults to <web-origin>/auth/silent-renew.
# VITE_OIDC_SILENT_REDIRECT_URI=https://sheets.example.com/auth/silent-renew

# Vite development proxy target. Production must expose /api and /ws from the
# same public origin as the web application.
REACT_SHEETS_API_ORIGIN=http://127.0.0.1:8082
