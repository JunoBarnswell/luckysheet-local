{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://react-sheets.local/contracts/workbook-snapshot.schema.json",
  "title": "WorkbookSnapshot",
  "type": "object",
  "required": ["schema", "version", "unitId", "name", "dimensionMetrics", "calculationSettings", "editingOptions", "definedNameModels", "dataModel", "sheets"],
  "properties": {
    "schema": { "const": "WorkbookSnapshot" },
    "version": { "const": 10 },
    "unitId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "dimensionMetrics": {
      "type": "object",
      "required": ["normalFontFamily", "normalFontSizePx", "maximumDigitWidthPx"],
      "properties": {
        "normalFontFamily": { "type": "string", "minLength": 1 },
        "normalFontSizePx": { "type": "number", "exclusiveMinimum": 0 },
        "maximumDigitWidthPx": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "calculationSettings": { "type": "object" },
    "collationContext": { "type": "object" },
    "editingOptions": {
      "type": "object",
      "required": ["allowEditDirectly", "moveAfterEnter", "enterDirection", "formulaAutoComplete", "valueAutoComplete", "fixedDecimalPlaces"],
      "properties": {
        "allowEditDirectly": { "type": "boolean" },
        "moveAfterEnter": { "type": "boolean" },
        "enterDirection": { "enum": ["down", "up", "right", "left"] },
        "formulaAutoComplete": { "type": "boolean" },
        "valueAutoComplete": { "type": "boolean" },
        "fixedDecimalPlaces": { "type": ["integer", "null"], "minimum": 0, "maximum": 15 }
      },
      "additionalProperties": false
    },
    "dataModel": {
      "type": "object",
      "required": ["sources", "tables", "relationships", "views"],
      "properties": {
        "sources": { "type": "array" },
        "tables": { "type": "array" },
        "relationships": { "type": "array" },
        "views": { "type": "array" }
      },
      "additionalProperties": false
    },
    "definedNameModels": {
      "type": "array",
      "items": { "$ref": "#/$defs/definedNameModel" }
    },
    "theme": { "type": "object" },
    "printDocuments": { "type": "array" },
    "queryDefinitions": { "type": "array" },
    "cellStyleTemplates": { "type": "array" },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/worksheet" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "definedNameModel": {
      "type": "object",
      "required": ["name", "formula", "scope"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "formula": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["workbook", "sheet"] },
        "sheetId": { "type": "string", "minLength": 1 },
        "anchor": {
          "type": "object",
          "required": ["sheetId", "row", "column"],
          "properties": {
            "sheetId": { "type": "string", "minLength": 1 },
            "row": { "type": "integer", "minimum": 0 },
            "column": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "hidden": { "type": "boolean" },
        "comment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pane": {
      "oneOf": [
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "none" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["kind", "xSplit", "ySplit", "startRow", "startColumn", "state"],
          "properties": {
            "kind": { "enum": ["frozen", "split"] },
            "xSplit": { "type": "number", "minimum": 0 },
            "ySplit": { "type": "number", "minimum": 0 },
            "startRow": { "type": "integer", "minimum": 0 },
            "startColumn": { "type": "integer", "minimum": 0 },
            "activePane": { "enum": ["topLeft", "topRight", "bottomLeft", "bottomRight"] },
            "state": { "enum": ["frozen", "frozenSplit", "split"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "positiveSizeMap": {
      "type": "object",
      "patternProperties": { "^(0|[1-9][0-9]*)$": { "type": "number", "exclusiveMinimum": 0 } },
      "additionalProperties": false
    },
    "autoFilter": {
      "type": "object",
      "required": ["sheetId", "range", "columns"],
      "properties": {
        "sheetId": { "type": "string", "minLength": 1 },
        "range": { "type": "object" },
        "columns": { "type": "object", "additionalProperties": { "type": "object" } },
        "sortState": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "worksheet": {
      "type": "object",
      "required": ["kind", "id", "name", "rowCount", "columnCount", "cells", "merges", "pane", "pivots", "sparklines", "drawings", "drawingPayloads", "review", "defaultRowHeightPx", "defaultColumnWidthPx"],
      "properties": {
        "kind": { "enum": ["worksheet", "table-sheet", "gantt-sheet", "report-sheet"] },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "rowCount": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "columnCount": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "cells": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "not": { "anyOf": [{ "required": ["hyperlink"] }, { "required": ["hyperlinkDetail"] }, { "required": ["note"] }, { "required": ["comment"] }] }
            }
          }
        },
        "merges": { "type": "array" },
        "pane": { "$ref": "#/$defs/pane" },
        "autoFilter": { "$ref": "#/$defs/autoFilter" },
        "dataRegions": { "type": "array" },
        "pivots": { "type": "array" },
        "sparklines": { "type": "array" },
        "sparklineGroups": { "type": "array" },
        "conditionalFormats": { "type": "array" },
        "dataValidations": { "type": "array" },
        "drawings": { "type": "array" },
        "drawingPayloads": { "type": "object" },
        "drawingGroups": { "type": "array" },
        "snapSettings": { "type": "object" },
        "hyperlinks": { "type": "array" },
        "review": {
          "type": "object",
          "required": ["notesByCell", "notesById", "threadIdsByCell", "threadsById"],
          "properties": {
            "notesByCell": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
            "notesById": { "type": "object", "additionalProperties": { "type": "object" } },
            "threadIdsByCell": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } } },
            "threadsById": { "type": "object", "additionalProperties": { "type": "object" } }
          },
          "additionalProperties": false
        },
        "defaultRowHeightPx": { "type": "number", "exclusiveMinimum": 0 },
        "defaultColumnWidthPx": { "type": "number", "exclusiveMinimum": 0 },
        "rowHeightsPx": { "$ref": "#/$defs/positiveSizeMap" },
        "columnWidthsPx": { "$ref": "#/$defs/positiveSizeMap" },
        "hiddenRows": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "hiddenColumns": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "tabColor": { "type": "string" },
        "bandedRule": { "type": "object" },
        "sheetTables": { "type": "array" },
        "spillRanges": { "type": "array" },
        "protectionRules": { "type": "array" },
        "showGridlines": { "type": "boolean" },
        "showHeaders": { "type": "boolean" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 },
        "hidden": { "type": "boolean" },
        "outline": { "type": "object" },
        "tableSheet": { "type": "object" },
        "ganttSheet": { "type": "object" },
        "reportSheet": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
